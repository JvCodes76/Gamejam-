[gd_scene format=3]

[ext_resource type="Script" path="res://inventory/item_tooltip.gd" id="1"]

[node name="ItemTooltip" type="PanelContainer"]
process_mode = 3
mouse_filter = 2
script = ExtResource("1")

[node name="VBox" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 2

[node name="NameLabel" type="Label" parent="VBox"]
layout_mode = 2
theme_override_font_sizes/font_size = 12

[node name="RarityLabel" type="Label" parent="VBox"]
layout_mode = 2
theme_override_font_sizes/font_size = 10

[node name="AspectsLabel" type="RichTextLabel" parent="VBox"]
layout_mode = 2
theme_override_font_sizes/normal_font_size = 10
bbcode_enabled = true
fit_content = true
scroll_active = false

[node name="EffectsLabel" type="Label" parent="VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.9, 0.85, 0.6, 1)
theme_override_font_sizes/font_size = 10
