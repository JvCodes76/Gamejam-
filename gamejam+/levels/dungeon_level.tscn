[gd_scene format=3]

[ext_resource type="Script" path="res://dungeon/dungeon_level.gd" id="1_level"]
[ext_resource type="PackedScene" path="res://player/player.tscn" id="2_player"]
[ext_resource type="PackedScene" path="res://enemies/enemy_base.tscn" id="3_enemy"]
[ext_resource type="PackedScene" path="res://enemies/skull.tscn" id="4_skull"]
[ext_resource type="PackedScene" path="res://ui/hud.tscn" id="5_hud"]
[ext_resource type="PackedScene" path="res://cauldron/cauldron.tscn" id="6_cauldron"]
[ext_resource type="Script" path="res://inventory/ground_item_spawner.gd" id="7_gis"]
[ext_resource type="Script" path="res://dungeon/dungeon_hud.gd" id="8_dhud"]
[ext_resource type="Script" path="res://dungeon/minimap.gd" id="9_minimap"]
[ext_resource type="PackedScene" path="res://enemies/bat.tscn" id="10_bat"]
[ext_resource type="PackedScene" path="res://ui/run_summary.tscn" id="11_summary"]
[ext_resource type="PackedScene" path="res://enemies/fire_skull_elite.tscn" id="20_fire_skull_elite"]
[ext_resource type="PackedScene" path="res://enemies/ghost_elite.tscn" id="21_ghost_elite"]
[ext_resource type="PackedScene" path="res://enemies/mushroom_elite.tscn" id="22_mushroom_elite"]
[ext_resource type="PackedScene" path="res://enemies/fire_skull.tscn" id="23_fire_skull"]
[ext_resource type="PackedScene" path="res://enemies/mushroom.tscn" id="24_mushroom"]
[ext_resource type="PackedScene" path="res://enemies/boss_fallen_angel.tscn" id="12_boss"]
[ext_resource type="Script" path="res://ui/boss_health_bar.gd" id="13_bossbar"]

[node name="DungeonLevel" type="Node2D"]
y_sort_enabled = true
script = ExtResource("1_level")
swarm_scenes = Array[PackedScene]([ExtResource("4_skull"), ExtResource("10_bat"), ExtResource("23_fire_skull"), ExtResource("24_mushroom")])
elite_scenes = Array[PackedScene]([ExtResource("20_fire_skull_elite"), ExtResource("21_ghost_elite"), ExtResource("22_mushroom_elite")])
elite_scene = ExtResource("3_enemy")
boss_scene = ExtResource("12_boss")
cauldron_scene = ExtResource("6_cauldron")

[node name="Player" parent="." instance=ExtResource("2_player")]

[node name="Enemies" type="Node2D" parent="."]
y_sort_enabled = true

; Ground items come only from item rooms (no initial items)
[node name="GroundItemSpawner" type="Node2D" parent="."]
script = ExtResource("7_gis")
seed_on_first_load = false

; Before the HUD: on the same layer, inventory and pause draw above the boss bar
[node name="BossHealthBar" type="CanvasLayer" parent="."]
script = ExtResource("13_bossbar")

[node name="HUD" parent="." instance=ExtResource("5_hud")]

[node name="DungeonHud" type="CanvasLayer" parent="."]
script = ExtResource("8_dhud")

[node name="Minimap" type="CanvasLayer" parent="."]
script = ExtResource("9_minimap")

[node name="RunSummary" parent="." instance=ExtResource("11_summary")]
